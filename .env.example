# Copie para .env (ignorado pelo git). Nunca versione valores reais.
# Caminho do livro-caixa. O arquivo fica FORA do repositório.
SQLITE_PATH=/Users/danielvm/Documents/My_Finances/livro-caixa.sqlite
# API do BigBase usada pelo sync (servidor local). Cliente lê collections com Bearer após login Neon.
VITE_BIGBASE_URL=https://bigbase.click
# URL Neon Auth (Managed Better Auth). Ver scripts/neon-auth-setup.sh
VITE_NEON_AUTH_URL=
# bigbase | mock  (mock só para desenvolvimento e e2e)
VITE_AUTH_MODE=bigbase
# URL pública do site (health.sh)
SITE_URL=https://big-caixa.bigbase.click
