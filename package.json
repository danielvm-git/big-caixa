{
	"name": "big-caixa",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/write-health.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"preflight": "bash scripts/preflight.sh",
		"start": "node server/index.mjs",
		"dev:server": "mkdir -p local && LOCAL_DEV=true CAIXA_DB=local/caixa.db PORT=8787 node --watch server/index.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.6",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"jsdom": "^31.0.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-eslint-parser": "^1.11.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"description": "big-caixa: livro-caixa da casa — SvelteKit + servidor Node com SQLite, atrás do Cloudflare Access",
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"jose": "^6.2.18"
	}
}
